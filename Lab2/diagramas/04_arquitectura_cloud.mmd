flowchart TB
  U["Usuarios · Clientes · Empleados remotos"]:::ext
  U -->|HTTPS/TLS| WAF
  WAF["WAF + CDN · Anti-DDoS"]:::edge
  WAF --> ID
  ID["IAM + MFA + RBAC<br/>Mínimo privilegio · VPN / ZTNA"]:::idn
  ID --> LB
  subgraph VPC["Red segmentada (VPC)"]
    direction TB
    LB["Balanceador de carga"]:::net
    subgraph SAPP["Subred privada · aplicaciones"]
      APP["App web clientes"]:::app
      CRM["CRM"]:::app
      FIN["Sistema financiero"]:::app
      DOC["Gestión documental"]:::app
    end
    subgraph SDAT["Subred privada · datos"]
      DB[("Base de datos<br/>cifrada")]:::data
      ST[("Almacenamiento<br/>cifrado · CSPM")]:::data
    end
    LB --> APP
    LB --> CRM
    LB --> FIN
    LB --> DOC
    APP --> DB
    CRM --> DB
    FIN --> DB
    DOC --> ST
  end
  KMS["KMS · Gestión de claves<br/>Cifrado en reposo"]:::key
  KMS -.-> DB
  KMS -.-> ST
  BK[("Backups inmutables / offline<br/>regla 3-2-1 · probados")]:::bk
  DB -. copias .-> BK
  ST -. copias .-> BK
  SIEM["Logging centralizado + SIEM + Monitoreo<br/>(transversal: observa todas las capas)"]:::mon
  SIEM -.-> ID
  SIEM -.-> SDAT
