flowchart TB
  req["Petición HTTP con JSON<br/>que nombra una clase<br/>en un argumento genérico"]
  om["ObjectMapper con tipado<br/>polimórfico por nombre de clase<br/>(activateDefaultTyping / @JsonTypeInfo CLASS)"]
  ptv["PolymorphicTypeValidator<br/>solo valida el tipo exterior<br/>(DatabindContext, jackson-databind 3.1.7 y 2.21.7)"]
  gad["Instancia una clase gadget<br/>del classpath"]
  rce["Ejecución de código en la API<br/>con sus credenciales de MongoDB,<br/>MQTT y JWT"]
  sp["SmartPot-API: 0 usos de tipado<br/>polimórfico (grep sobre src/main)"]
  fix["Jackson 3.1.8 y 2.21.8:<br/>valida también los argumentos genéricos"]
  req --> om --> ptv --> gad --> rce
  sp -. "corta la cadena:<br/>no alcanzable hoy" .-> om
  fix -. "corta la cadena<br/>aunque el código cambie" .-> ptv

  classDef core fill:#DDF5EA,stroke:#067A52,color:#17261F
