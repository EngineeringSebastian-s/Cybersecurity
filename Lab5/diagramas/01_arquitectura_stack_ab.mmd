flowchart LR
  dev["Dispositivos<br/>ESP32 · Wokwi · simulador"]
  user["Persona usuaria<br/>navegador · Telegram · cliente MCP"]
  subgraph A["Stack A · producción en smartpot.app"]
    direction TB
    a_web["SmartPot-Web<br/>React 19 · nginx"]
    a_api["SmartPot-API<br/>Spring Boot 4 · Java 21<br/>imagen Temurin JRE"]
    a_db[("SmartPot-DB<br/>MongoDB 8")]
    a_cache[("SmartPot-Cache<br/>Redis 8")]
    a_broker["SmartPot-Broker<br/>Mosquitto 2.1"]
    a_sim["SmartPot-DataGenerator<br/>Python"]
  end
  subgraph B["Stack B · destino demo-beta"]
    direction TB
    b_web["SmartPot-Web-Solid<br/>SolidJS · nginx sin privilegios"]
    b_api["SmartPot-API-Go<br/>Echo · imagen scratch"]
    b_db[("SmartPot-DB-Postgre<br/>PostgreSQL 17 + TimescaleDB")]
    b_cache[("SmartPot-Cache-Valkey<br/>Valkey 9")]
    b_broker["SmartPot-Broker-EMQX<br/>EMQX 5.8 · authn delegada en la API"]
    b_sim["SmartPot-DataGenerator-Rust<br/>Axum · Tokio"]
  end
  subgraph S["Compartidos"]
    direction TB
    ai["SmartPot-AI<br/>FastAPI + núcleo C++20"]
    mcp["SmartPot-MCP<br/>token por cuenta"]
    mail["SmartPot-Mail<br/>Mailpit"]
  end
  user --> a_web & b_web
  user --> mcp
  dev -- "MQTT v1 · TLS 8883" --> a_broker & b_broker
  a_web --> a_api --> a_db & a_cache
  a_api --> a_broker
  b_web --> b_api --> b_db & b_cache
  b_api --> b_broker
  a_api & b_api --> ai & mail
  mcp --> b_api
  a_sim --> a_broker
  b_sim --> b_broker

