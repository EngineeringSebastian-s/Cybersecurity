flowchart TB
  subgraph s1["1 · Antes del PR"]
    direction LR
    ide["Reglas del agente<br/>y Snyk en el IDE"] --> pc["pre-commit<br/>gitleaks · ruff · semgrep"] --> pr["PR desde rama<br/>security/ o quality/"]
  end
  subgraph s2["2 · Checks requeridos: bloquean con crítica o alta"]
    direction LR
    cq["CodeQL"] ~~~ so["Snyk<br/>Open Source"] ~~~ sk["Snyk<br/>Code"] ~~~ sct["Snyk Container<br/>imagen candidata"] ~~~ iac["Snyk<br/>IaC"] ~~~ tests["Pruebas<br/>y E2E"]
  end
  subgraph s3["3 · Después del merge"]
    direction LR
    pk["Imagen publicada<br/>en GHCR"] --> mon["snyk monitor<br/>+ Dependabot"]
    gk["Deployment Gatekeeper<br/>Snyk IaC · umbral high"] --> prod["Producción<br/>despliegue aprobado"]
  end
  s1 ==> s2 ==> s3

  classDef core fill:#DDF5EA,stroke:#067A52,color:#17261F
  classDef platform fill:#E3F2FB,stroke:#1F6FA0,color:#17261F
  classDef store fill:#F2F7F4,stroke:#5B6B63,color:#17261F
  classDef device fill:#FDF4DD,stroke:#C98D12,color:#17261F
  classDef alert fill:#FBE4E4,stroke:#B83232,color:#17261F
  classDef dark fill:#0B3D2B,stroke:#06281C,color:#FFFFFF
  class ide,pc platform
  class pr,pk store
  class cq,so,sk,sct,iac,tests core
  class gk dark
  class prod device
  class mon platform
