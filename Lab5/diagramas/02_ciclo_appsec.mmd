%%{init: {"theme": "base", "fontFamily": "Segoe UI, Arial, sans-serif", "themeVariables": {"fontFamily": "Segoe UI, Arial, sans-serif", "fontSize": "15px", "primaryColor": "#DDF5EA", "primaryTextColor": "#17261F", "primaryBorderColor": "#067A52", "secondaryColor": "#E3F2FB", "secondaryTextColor": "#17261F", "secondaryBorderColor": "#1F6FA0", "tertiaryColor": "#F2F7F4", "tertiaryTextColor": "#17261F", "tertiaryBorderColor": "#D5E3DC", "lineColor": "#5B6B63", "textColor": "#17261F", "mainBkg": "#DDF5EA", "nodeBorder": "#067A52", "clusterBkg": "#F7FAF8", "clusterBorder": "#D5E3DC", "edgeLabelBackground": "#FFFFFF", "actorBkg": "#067A52", "actorBorder": "#0B3D2B", "actorTextColor": "#FFFFFF", "actorLineColor": "#5B6B63", "signalColor": "#17261F", "signalTextColor": "#17261F", "labelBoxBkgColor": "#0B3D2B", "labelBoxBorderColor": "#0B3D2B", "labelTextColor": "#FFFFFF", "loopTextColor": "#0B3D2B", "noteBkgColor": "#FDF4DD", "noteBorderColor": "#C98D12", "noteTextColor": "#17261F", "activationBkgColor": "#DDF5EA", "activationBorderColor": "#067A52", "attributeBackgroundColorOdd": "#FFFFFF", "attributeBackgroundColorEven": "#F2F7F4"}}}%%
flowchart TB
  subgraph f1["Entender el hallazgo"]
    direction LR
    det["1 · Detección<br/>Snyk CLI y Web<br/>CodeQL · Dependabot<br/>cargo-audit · secretos"]
    ana["2 · Análisis<br/>CVE · CWE · CVSS<br/>exploit · alcanzabilidad"]
    pri["3 · Priorización<br/>probabilidad × impacto<br/>en SmartPot"]
    det --> ana --> pri
  end
  subgraph f2["Actuar sobre él"]
    direction LR
    rem["4 · Remediación<br/>un PR por causa raíz"]
    ver["5 · Verificación<br/>reescaneo · pruebas<br/>artefacto publicado"]
    pre["6 · Prevención<br/>quality gates · reglas<br/>política de dependencias"]
    rem --> ver --> pre
  end
  vuelta["Si el reescaneo falla, o snyk monitor avisa de una CVE nueva, el ciclo vuelve a 1"]
  f1 ==> f2 -.-> vuelta

  classDef core fill:#DDF5EA,stroke:#067A52,color:#17261F
  classDef platform fill:#E3F2FB,stroke:#1F6FA0,color:#17261F
  classDef store fill:#F2F7F4,stroke:#5B6B63,color:#17261F
  classDef device fill:#FDF4DD,stroke:#C98D12,color:#17261F
  classDef alert fill:#FBE4E4,stroke:#B83232,color:#17261F
  classDef dark fill:#0B3D2B,stroke:#06281C,color:#FFFFFF
  class det,ana,pri platform
  class rem,ver core
  class pre dark
  class vuelta device
