%%{init: {"theme": "base", "fontFamily": "Segoe UI, Arial, sans-serif", "themeVariables": {"fontFamily": "Segoe UI, Arial, sans-serif", "fontSize": "17px", "primaryColor": "#DDF5EA", "primaryTextColor": "#17261F", "primaryBorderColor": "#067A52", "secondaryColor": "#E3F2FB", "secondaryTextColor": "#17261F", "secondaryBorderColor": "#1F6FA0", "tertiaryColor": "#F2F7F4", "tertiaryTextColor": "#17261F", "tertiaryBorderColor": "#D5E3DC", "lineColor": "#5B6B63", "textColor": "#17261F", "mainBkg": "#DDF5EA", "nodeBorder": "#067A52", "clusterBkg": "#F7FAF8", "clusterBorder": "#D5E3DC", "edgeLabelBackground": "#FFFFFF", "actorBkg": "#067A52", "actorBorder": "#0B3D2B", "actorTextColor": "#FFFFFF", "actorLineColor": "#5B6B63", "signalColor": "#17261F", "signalTextColor": "#17261F", "labelBoxBkgColor": "#0B3D2B", "labelBoxBorderColor": "#0B3D2B", "labelTextColor": "#FFFFFF", "loopTextColor": "#0B3D2B", "noteBkgColor": "#FDF4DD", "noteBorderColor": "#C98D12", "noteTextColor": "#17261F", "activationBkgColor": "#DDF5EA", "activationBorderColor": "#067A52", "attributeBackgroundColorOdd": "#FFFFFF", "attributeBackgroundColorEven": "#F2F7F4"}, "flowchart": {"wrappingWidth": 330}}}%%
flowchart TB
  subgraph S1["1. Ataque (fechas supuestas)"]
    direction LR
    a1["Días previos<br/>presencia en la red interna<br/>y reconocimiento del segmento"]:::alert --> a2["Antes del 10 de marzo<br/>envenenamiento ARP, interceptación,<br/>suplantación de IP y consultas masivas"]:::alert
  end
  subgraph S2["2. Detección y contención"]
    direction LR
    b1["10 de marzo, hora 0<br/>TI detecta los accesos; se activan<br/>el Comité de Crisis y el plan de recuperación"]:::core --> b2["Primeras 4 a 24 horas<br/>clasificación como incidente grave<br/>y notificación inicial a la DGSFP"]:::core
  end
  subgraph S3["3. Obligaciones legales"]
    direction LR
    c1["Hasta 72 horas<br/>notificación a la AEPD, comunicación a<br/>los afectados e informe intermedio DORA"]:::dark --> c2["Hasta un mes<br/>informe final DORA<br/>y lecciones aprendidas"]:::dark
  end
  subgraph S4["4. Recuperación y mejora"]
    direction LR
    d1["De 30 a 90 días<br/>cierre de brechas<br/>por horizontes"]:::platform --> d2["De 91 a 180 días<br/>auditoría de verificación<br/>y revisión por la dirección"]:::platform
  end
  S1 --> S2 --> S3 --> S4
  classDef core fill:#DDF5EA,stroke:#067A52,color:#17261F
  classDef platform fill:#E3F2FB,stroke:#1F6FA0,color:#17261F
  classDef store fill:#F2F7F4,stroke:#5B6B63,color:#17261F
  classDef device fill:#FDF4DD,stroke:#C98D12,color:#17261F
  classDef alert fill:#FBE4E4,stroke:#B83232,color:#17261F
  classDef dark fill:#0B3D2B,stroke:#06281C,color:#FFFFFF
