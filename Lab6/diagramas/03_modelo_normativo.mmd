flowchart LR
  subgraph EXT["Marco externo: lo que la organización debe o decide seguir"]
    direction TB
    L["LEYES · obligatorias en su ámbito<br/>RGPD · LOPDGDD · DORA · Código Penal<br/>Espejo colombiano: Ley 1581 · Ley 1273"]:::dark
    N["NORMA · requisitos de un sistema de gestión<br/>ISO/IEC 27001:2022 · ISO 22301"]:::core
    M["MARCOS · estructura para gestionar<br/>NIST CSF 2.0 · COBIT · ITIL"]:::platform
    B["BUENAS PRÁCTICAS · cómo implementar<br/>ISO/IEC 27002 · CIS Controls · guías técnicas"]:::store
    L --> N --> M --> B
  end
  subgraph INT["Normativa interna de la aseguradora"]
    direction TB
    P["POLÍTICA DE SEGURIDAD DE LA INFORMACIÓN<br/>aprobada por la Dirección y comunicada"]:::dark
    NI["NORMAS INTERNAS<br/>red · acceso · cifrado · clasificación<br/>incidentes · continuidad"]:::core
    PR["PROCEDIMIENTOS E INSTRUCTIVOS<br/>quién hace qué, cuándo y con qué herramienta"]:::platform
    R["REGISTROS Y EVIDENCIAS<br/>lo que el auditor pide para comprobar el control"]:::device
    P --> NI --> PR --> R
    R -. "auditoría, revisión por la<br/>dirección y mejora continua" .-> P
  end
  EXT ==>|"se traduce en"| INT
  classDef core fill:#DDF5EA,stroke:#067A52,color:#17261F
  classDef platform fill:#E3F2FB,stroke:#1F6FA0,color:#17261F
  classDef store fill:#F2F7F4,stroke:#5B6B63,color:#17261F
  classDef device fill:#FDF4DD,stroke:#C98D12,color:#17261F
  classDef alert fill:#FBE4E4,stroke:#B83232,color:#17261F
  classDef dark fill:#0B3D2B,stroke:#06281C,color:#FFFFFF
